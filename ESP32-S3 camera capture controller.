#define EI_CLASSIFIER_USE_PSRAM 0
#define EI_CLASSIFIER_TFLITE_ARENA_SIZE 100000
#define EI_CLASSIFIER_TFLITE_ENABLE_ESP_NN 0

#include <Eye_tracking_inferencing.h>
#include "esp_camera.h"
#include "driver/ledc.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include <WiFi.h>
#include <WiFiUdp.h>

const char* ssid = "";
const char* password = "";
const char* receiver_ip = "10.129.120.115";
const int UDP_PORT = 8888;

WiFiUDP udp;

#define PWDN_GPIO_NUM    -1
#define RESET_GPIO_NUM   -1
#define XCLK_GPIO_NUM    12
#define SIOD_GPIO_NUM    3
#define SIOC_GPIO_NUM    4
#define VSYNC_GPIO_NUM   9
#define HREF_GPIO_NUM    10
#define PCLK_GPIO_NUM    11
#define Y2_GPIO_NUM      15
#define Y3_GPIO_NUM      14
#define Y4_GPIO_NUM      8
#define Y5_GPIO_NUM      36
#define Y6_GPIO_NUM      35
#define Y7_GPIO_NUM      37
#define Y8_GPIO_NUM      44
#define Y9_GPIO_NUM      39

static bool camera_ready = false;
static float *resized_buf = NULL;

void sendUDP(const char* message) {
  udp.beginPacket(receiver_ip, UDP_PORT);
  udp.write((const uint8_t*)message, strlen(message));
  udp.endPacket();
}

void resize_160x120_to_96x96_gray(uint8_t* src, float* dst) {
  for (int y = 0; y < 96; y++) {
    for (int x = 0; x < 96; x++) {
      int sx = x * 160 / 96;
      int sy = y * 120 / 96;
      dst[y * 96 + x] = ((float)src[sy * 160 + sx] - 128.0f) / 128.0f;
    }
  }
}

int ei_camera_get_data(size_t offset, size_t length, float *out_ptr) {
  memcpy(out_ptr, resized_buf + offset, length * sizeof(float));
  return 0;
}

void classifier_task(void *pvParameters) {
  while (true) {
    if (!camera_ready) {
      vTaskDelay(200 / portTICK_PERIOD_MS);
      continue;
    }

    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) {
      vTaskDelay(200 / portTICK_PERIOD_MS);
      continue;
    }

    resize_160x120_to_96x96_gray(fb->buf, resized_buf);
    esp_camera_fb_return(fb);

    ei::signal_t signal;
    signal.total_length = 96 * 96;
    signal.get_data = &ei_camera_get_data;

    ei_impulse_result_t result = {0};
    EI_IMPULSE_ERROR err = run_classifier(&signal, &result, false);

    if (err != EI_IMPULSE_OK) {
      Serial.printf("Classifier error: %d\n", err);
      vTaskDelay(500 / portTICK_PERIOD_MS);
      continue;
    }

    for (size_t i = 0; i < EI_CLASSIFIER_LABEL_COUNT; i++) {
      Serial.printf("%s:%.2f ", result.classification[i].label, result.classification[i].value);
    }
    Serial.println();

    float blink_val = result.classification[0].value;
    float left_val  = result.classification[1].value;
    float right_val = result.classification[2].value;

    if (blink_val > 0.33) {
      Serial.printf("Prediction: blink (%.2f)\n", blink_val);
      sendUDP("blink");
    } else if (left_val > 0.50) {
      Serial.printf("Prediction: left (%.2f)\n", left_val);
      sendUDP("left");
    } else if (right_val > 0.50) {
      Serial.printf("Prediction: right (%.2f)\n", right_val);
      sendUDP("right");
    } else {
      sendUDP("open");
    }

    vTaskDelay(10 / portTICK_PERIOD_MS);
  }
}

void setup() {
  Serial.begin();
  delay(3000);
  Serial.println("Booting...");

  Serial.printf("Labels: %d\n", EI_CLASSIFIER_LABEL_COUNT);
  for (int i = 0; i < EI_CLASSIFIER_LABEL_COUNT; i++) {
    Serial.printf("  %d: %s\n", i, ei_classifier_inferencing_categories[i]);
  }

  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("WiFi connected! IP: ");
  Serial.println(WiFi.localIP());
  udp.begin(UDP_PORT);

  ledc_timer_config_t timer = {
    .speed_mode      = LEDC_LOW_SPEED_MODE,
    .duty_resolution = LEDC_TIMER_1_BIT,
    .timer_num       = LEDC_TIMER_0,
    .freq_hz         = 10000000,
    .clk_cfg         = LEDC_AUTO_CLK
  };
  ledc_timer_config(&timer);

  ledc_channel_config_t channel = {
    .gpio_num   = XCLK_GPIO_NUM,
    .speed_mode = LEDC_LOW_SPEED_MODE,
    .channel    = LEDC_CHANNEL_0,
    .timer_sel  = LEDC_TIMER_0,
    .duty       = 1,
    .hpoint     = 0
  };
  ledc_channel_config(&channel);
  delay(2000);

  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;
  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sscb_sda = SIOD_GPIO_NUM;
  config.pin_sscb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;
  config.xclk_freq_hz = 10000000;
  config.pixel_format = PIXFORMAT_GRAYSCALE;
  config.frame_size   = FRAMESIZE_QQVGA;
  config.jpeg_quality = 12;
  config.fb_count     = 1;
  config.fb_location  = CAMERA_FB_IN_DRAM;
  config.grab_mode    = CAMERA_GRAB_LATEST;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Camera init failed: 0x%x\n", err);
    return;
  }
  Serial.println("Camera OK");

  for (int i = 0; i < 10; i++) {
    camera_fb_t *fb = esp_camera_fb_get();
    if (fb) esp_camera_fb_return(fb);
    delay(100);
  }

  resized_buf = (float*)malloc(96 * 96 * sizeof(float));
  if (!resized_buf) {
    Serial.println("Buffer alloc failed");
    return;
  }
  Serial.println("Buffer OK");

  camera_ready = true;

  xTaskCreatePinnedToCore(
    classifier_task,
    "classifier",
    65536,
    NULL,
    1,
    NULL,
    0
  );
}

void loop() {
  vTaskDelay(1000 / portTICK_PERIOD_MS);
}
